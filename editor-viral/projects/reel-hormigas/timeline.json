    "text": [
      { "content": "Las hormigas NO DUERMEN. Nunca.", "start": 0, "end": 2, "style": "hook", "font": "Bebas", "size": 130, "color": "#FFD700", "stroke": "#000000", "stroke_width": 5, "x": "(w-text_w)/2", "y": "(h-text_h)/2", "animation": "scale-bounce" },
      { "content": "100 millones de años dominando la Tierra", "start": 2, "end": 4, "style": "fact", "font": "Anton", "size": 56, "color": "#FF6B6B", "stroke": "#000000", "stroke_width": 3, "x": "(w-text_w)/2", "y": "h-180", "animation": "slide-up" },
      { "content": "300,000 huevos en una vida", "start": 4, "end": 7, "style": "counter", "font": "JetBrains Mono", "size": 72, "color": "#00FF88", "x": "(w-text_w)/2", "y": "(h-text_h)/2", "animation": "count-up" },
      { "content": "Obreira\\: 45 días  \\|  Reina\\: 30 AÑOS", "start": 7.5, "end": 12, "style": "fact", "font": "Bebas", "size": 52, "color": "#FFD700", "stroke": "#000000", "stroke_width": 4, "x": "(w-text_w)/2", "y": "(h-text_h)/2", "animation": "pulse" },
      { "content": "Mismo ADN. Destino distinto. Solo por la COMIDA.", "start": 12.5, "end": 17, "style": "fact", "font": "Inter", "size": 48, "color": "#FFFFFF", "stroke": "#000000", "stroke_width": 3, "x": "(w-text_w)/2", "y": "h-200", "animation": "typewriter" },
      { "content": "Jalea real = reina. Comida normal = obrera.", "start": 17, "end": 21, "style": "fact", "font": "Anton", "size": 56, "color": "#4ECDC4", "stroke": "#000000", "stroke_width": 3, "x": "(w-text_w)/2", "y": "h-180", "animation": "shake" },
      { "content": "Internet químico: feromonas", "start": 21.5, "end": 25, "style": "fact", "font": "Bangers", "size": 52, "color": "#FF6B6B", "stroke": "#000000", "stroke_width": 3, "x": "(w-text_w)/2", "y": "h-200", "animation": "slide-up" },
      { "content": "Una encuentra azúcar \\-> cientos la siguen en MINUTOS", "start": 25, "end": 29, "style": "fact", "font": "Inter", "size": 44, "color": "#FFFFFF", "stroke": "#000000", "stroke_width": 2, "x": "(w-text_w)/2", "y": "h-180", "animation": "typewriter" },
      { "content": "Cazan en EQUIPO. Presas 1000x su tamaño.", "start": 29.5, "end": 33, "style": "fact", "font": "Bebas", "size": 56, "color": "#FFD700", "stroke": "#000000", "stroke_width": 4, "x": "(w-text_w)/2", "y": "(h-text_h)/2", "animation": "pulse" },
      { "content": "Agricultores: cultivan hongos desde hace 50 MILLONES de años", "start": 33.5, "end": 38, "style": "fact", "font": "Inter", "size": 46, "color": "#00FF88", "stroke": "#000000", "stroke_width": 3, "x": "(w-text_w)/2", "y": "h-200", "animation": "slide-up" },
      { "content": "Ganaderos: crían pulgones como ganado", "start": 38, "end": 41, "style": "fact", "font": "Anton", "size": 52, "color": "#4ECDC4", "stroke": "#000000", "stroke_width": 3, "x": "(w-text_w)/2", "y": "h-180", "animation": "shake" },
      { "content": "Su biomasa \\> TODA la humanidad junta", "start": 41.5, "end": 45, "style": "counter", "font": "JetBrains Mono", "size": 64, "color": "#FF6B6B", "x": "(w-text_w)/2", "y": "(h-text_h)/2", "animation": "count-up" },
      { "content": "Llevan aquí desde los DINOSAURIOS", "start": 45.5, "end": 49, "style": "fact", "font": "Bangers", "size": 64, "color": "#FFD700", "stroke": "#000000", "stroke_width": 4, "x": "(w-text_w)/2", "y": "(h-text_h)/2", "animation": "scale-bounce" },
      { "content": "Levantan 50x su peso. Construyen puentes con su cuerpo.", "start": 49.5, "end": 54, "style": "fact", "font": "Inter", "size": 46, "color": "#FFFFFF", "stroke": "#000000", "stroke_width": 2, "x": "(w-text_w)/2", "y": "h-180", "animation": "typewriter" },
      { "content": "No son insectos. Son un SUPERORGANISMO.", "start": 54.5, "end": 59, "style": "fact", "font": "Bebas", "size": 64, "color": "#00FF88", "stroke": "#000000", "stroke_width": 4, "x": "(w-text_w)/2", "y": "(h-text_h)/2", "animation": "pulse" },
      { "content": "La reina: el corazón que late 30 años.", "start": 61.5, "end": 66, "style": "fact", "font": "Inter", "size": 48, "color": "#FFD700", "stroke": "#000000", "stroke_width": 3, "x": "(w-text_w)/2", "y": "(h-text_h)/2", "animation": "fade-in" },
      { "content": "¿Qué otro insecto te parece increíble?", "start": 68.5, "end": 73, "style": "cta", "font": "Bebas", "size": 64, "color": "#FFD700", "x": "(w-text_w)/2", "y": "(h-text_h)/2 - 60", "animation": "pulse-loop" },
      { "content": "Comenta y sígueme 👇", "start": 73, "end": 78, "style": "cta", "font": "Inter", "size": 40, "color": "#FFFFFF", "x": "(w-text_w)/2", "y": "(h-text_h)/2 + 40", "animation": "fade-in" }
